# ---- Acesso ----
# Senha de admin (metas, vendedores, ajustar atribuição). Obrigatória.
ADMIN_PASSWORD=troque-isto
# Senha do time comercial para VER o dash. Deixe vazio para deixar aberto a quem tiver o link.
VIEW_PASSWORD=
# Qualquer texto longo e aleatório
SESSION_SECRET=um-texto-aleatorio-bem-grande

# ---- Webhooks (opcional, recomendado) ----
# Hubla: o "Hubla Token" que aparece na tela de webhooks (vem no cabeçalho x-hubla-token)
HUBLA_TOKEN=
# TMB: o "Valor" que você cadastrar no campo Chave/Valor do webhook
TMB_TOKEN=

# ---- Planilhas ----
# Modo 1 (recomendado): conta de serviço Google + pasta do Drive
DRIVE_FOLDER_ID=1lYFDH6F_tge4ZdJhKx9b7pp_bkotiwE3
# Cole o JSON inteiro da chave (ou ele em base64)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Modo 2 (sem Google Cloud): planilhas compartilhadas como "qualquer pessoa com o link"
# PUBLIC_SHEETS=Ana=1qimTqHEq4Y7ppg6C6ojspDkVlzqRZEgtWEpsxNjbTcQ;Isla=1p4fj_kfBVCAya3MtDPYZPgYx96Y-g7EvNbG8zri7bbo

# De quanto em quanto tempo relê as planilhas (segundos, mínimo 30)
SYNC_INTERVAL_SECONDS=120
